{
  "name": "@jpowersdev/effect-agent",
  "version": "0.1.0",
  "description": "Effect-native control of coding-agent CLIs (Claude Code, Codex): live sessions, steering, typed endings.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpowersdev/effect-agent.git"
  },
  "homepage": "https://github.com/jpowersdev/effect-agent#readme",
  "bugs": {
    "url": "https://github.com/jpowersdev/effect-agent/issues"
  },
  "keywords": [
    "effect",
    "agent",
    "claude",
    "claude-code",
    "codex",
    "llm"
  ],
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/index.js",
    "./claude": "./dist/claude/index.js",
    "./codex": "./dist/codex/index.js",
    "./host": "./dist/host/index.js"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "live:claude": "node scripts/live-claude.ts",
    "live:codex": "node scripts/live-codex.ts",
    "live:reattach": "node scripts/live-reattach.ts",
    "build": "pnpm build:tsc && pnpm build:babel",
    "build:tsc": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "prepack": "pnpm build",
    "check:pack": "node scripts/check-pack.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@effect/platform-node-shared": "^4.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.9",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/platform-bun": "4.1.0",
    "@effect/platform-node": "4.1.0",
    "@effect/vitest": "4.1.0",
    "@types/node": "^26.6.6",
    "babel-plugin-annotate-pure-calls": "^0.5.0",
    "effect": "4.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "effect": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
